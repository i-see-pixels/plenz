{
  "name": "extension",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build -c vite.site-script.config.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "e2e": "playwright test --project=extension",
    "e2e:live": "playwright test --project=live"
  },
  "dependencies": {
    "@plenz/core": "workspace:*",
    "@plenz/providers": "workspace:*",
    "@plenz/types": "workspace:*",
    "@plenz/ui": "workspace:*",
    "firebase": "^12.11.0",
    "lucide-react": "^1.0.1",
    "preact": "^10.28.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.8.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/chrome": "^0.1.38",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.4.5",
    "vite": "^7.3.1"
  }
}
